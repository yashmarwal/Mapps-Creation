# Supabase (see SUPABASE_SETUP.md)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web3Forms — sign up free at https://web3forms.com to get an access key,
# used by the /contact page form.
VITE_WEB3FORMS_ACCESS_KEY=

# Gemini (AI Chat Assistant) — free key from https://aistudio.google.com.
# Deliberately NOT VITE_-prefixed: it must stay server-only and never reach
# the client bundle. Read only inside the createServerFn handler in
# src/lib/aiAssistant.server.ts. If unset, the chat silently falls back to
# the local keyword-matched answers — nothing breaks.
GEMINI_API_KEY=
# Optional — defaults to gemini-3.5-flash-lite (fast/cheap, plenty for short
# text Q&A). Override only if you want a different model.
GEMINI_MODEL=
